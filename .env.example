
# Embedding Provider (always: opensource - no MongoDB)
EMBEDDING_PROVIDER=opensource

# Embedding Model - Change this to switch models
# Available models (with recommended dimensions):
#   - sentence-transformers/all-MiniLM-L6-v2 (384 dim, fastest)
#   - sentence-transformers/all-mpnet-base-v2 (768 dim, balanced)
#   - BAAI/bge-base-en-v1.5 (768 dim, good for EN)
#   - BAAI/bge-large-en-v1.5 (1024 dim, best quality for EN)
#   - BAAI/bge-large-zh-v1.5 (1024 dim, optimized for Chinese)
#   - nomic-ai/nomic-embed-text-v1.5 (768 dim, 8K context)  ← CURRENT
EMBEDDING_MODEL=BAAI/bge-m3
#nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=1024
    
# Retrieval Parameters
RETRIEVAL_K=10
SIMILARITY_METRIC=cosine

# Processing Settings
BATCH_SIZE=32
MAX_CORPUS_SIZE=0

# Subtask A Specific Configuration
INDEX_PATH=subtask_A/indexes
OUTPUT_PATH=subtask_A/results
CHUNK_SIZE=512
CHUNK_OVERLAP=100
MAX_SEQ_LENGTH=8192
NUM_WORKERS=4


# Domains to process (comma-separated)
# Available: clapnq, cloud, fiqa, govt
DOMAINS=clapnq,cloud,fiqa,govt

# Query types for retrieval
# Available: questions, rewrite, lastturn
QUERY_TYPES=questions,rewrite,lastturn


# Logging Level
LOG_LEVEL=INFO

# Device Configuration
# Options: cuda, cpu, auto (auto-detect)
# auto: uses GPU if available, falls back to CPU if not
DEVICE=auto

OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here